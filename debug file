# .github/workflows/debug-build.yml
name: Debug Docker Build

on:
  workflow_dispatch:   # lets you trigger it manually from the Actions tab

jobs:
  debug:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Build image
        run: docker build -t debug-image .

      - name: Check for validation_tool in image
        run: docker run --rm debug-image find /app -iname "validation_tool*"

      - name: Show full /app tree
        run: docker run --rm debug-image find /app -maxdepth 2

      - name: Try the actual import
        run: docker run --rm debug-image python -c "import validation_tool" || true
