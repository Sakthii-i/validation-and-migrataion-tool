# Minutes to subtract from Databricks TIMESTAMP columns sourced from a MySQL
# TIMESTAMP column (via Trino), to compensate for MySQL silently converting
# literal wall-clock values to a UTC instant based on the MySQL server's own
# timezone while Databricks stores the literal value with no conversion.
# 330 = 5h30m (IST). Set to 0 (or unset) to disable.
MYSQL_SOURCE_TZ_OFFSET_MINUTES=330

