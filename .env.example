# Credential encryption password
# This is used to decrypt the encrypted credential.txt file containing Snowflake and Databricks credentials
# IMPORTANT: Copy this file to .env and fill in your actual password
# IMPORTANT: Never commit the actual password to version control
CREDENTIAL_PASSWORD=<your-password-here>

# Supabase result persistence (required if you want dashboard/eye to read from Supabase)
# Example: https://abcd1234efgh5678.supabase.co
SUPABASE_URL=

# Provided publishable key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_HzIXmmpx_rJP4K8cNMLhRg_oQY3Yt_b

# Supabase table used by API
SUPABASE_RESULTS_TABLE=validation_results

# SMTP server settings used to send validation-failure report emails.
# Each user supplies their own Gmail App Password via the Admin panel
# (stored per-user in auth_credentials); these vars only control which
# server/port/TLS mode is used to connect.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Gmail App Password for the hardcoded admin account (sakthid282004@gmail.com,
# see ADMIN_EMAIL in backend/auth_config.py). Used only when the admin login
# runs a validation that fails.
ADMIN_SMTP_PASSWORD=
